# Local development only. Choose your own password before starting PostgreSQL.
POSTGRES_USER=more_dev
POSTGRES_PASSWORD=replace_with_your_own_dev_password
POSTGRES_DB=more
POSTGRES_PORT=5434

# Match the Compose settings above. URL-encode special characters in credentials.
DATABASE_URL="postgresql://more_dev:replace_with_your_own_dev_password@localhost:5434/more?schema=public"

# Generate each key independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep keys stable: changing lookup/encryption keys requires a planned data migration.
AUTH_SESSION_SECRET=replace_with_an_independently_generated_64_character_hex_key
NATIONAL_ID_LOOKUP_KEY=replace_with_an_independently_generated_64_character_hex_key
NATIONAL_ID_ENCRYPTION_KEY=replace_with_an_independently_generated_64_character_hex_key
# Set the exact public origin behind a reverse proxy, e.g. https://more.example.com
# AUTH_ORIGIN=http://localhost:3000

# Default off. `npm run demo` enables synthetic-only Demo criteria.
MORE_DEMO_MODE=0
DEMO_PORT=3001
